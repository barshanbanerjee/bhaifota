{
  "name": "bhaifota",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @bhaifota/web dev\" \"pnpm --filter @bhaifota/api start:dev\"",
    "build": "pnpm --filter @bhaifota/web build && pnpm --filter @bhaifota/api build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
