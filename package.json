{
  "name": "bhaifota",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @bhaifota/web dev",
    "build": "pnpm --filter @bhaifota/web build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
