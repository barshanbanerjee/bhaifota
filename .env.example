# ==========================================
# Bhaifota Environment Variables (Vercel & Local)
# ==========================================

# 1. Database (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication (JWT & Google OAuth)
JWT_SECRET="generate-a-secure-32-byte-hex-or-base64-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# 3. Media & Real-time Synchronization (LiveKit Cloud)
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://bhaifota-xxxxxx.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://bhaifota-xxxxxx.livekit.cloud"

# 4. Email Invitations (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxx"
EMAIL_FROM="Bhaifota <onboarding@resend.dev>"

# 5. Public URL (Set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
