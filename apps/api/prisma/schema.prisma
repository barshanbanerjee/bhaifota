generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiblingRole {
  BROTHER
  SISTER
}

enum RoomStatus {
  WAITING
  CONNECTED
  ACTIVE
  COMPLETED
  EXPIRED
}

enum RitualObject {
  CHANDAN
  MISTI
  DHAN_DURBA
}

enum RitualAction {
  APPLY
  OFFER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  image     String?
  createdAt DateTime @default(now())

  memberships        RoomParticipant[]
  invitationsCreated RoomInvitation[] @relation("InvitationCreator")
}

model Room {
  id        String     @id @default(cuid())
  code      String     @unique
  status    RoomStatus @default(WAITING)

  revision  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  participants RoomParticipant[]
  invitation   RoomInvitation?
  interactions RitualInteraction[]

  @@index([status, expiresAt])
}

model RoomParticipant {
  id       String      @id @default(cuid())
  roomId   String
  userId   String
  role     SiblingRole
  joinedAt DateTime    @default(now())
  leftAt   DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, role])
  @@index([userId])
}

model RoomInvitation {
  id           String           @id @default(cuid())
  roomId       String           @unique
  creatorId    String
  invitedEmail String
  invitedRole  SiblingRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator User @relation("InvitationCreator", fields: [creatorId], references: [id])

  @@index([invitedEmail, status])
  @@index([expiresAt])
}

model RitualInteraction {
  id        String       @id @default(cuid())
  roomId    String
  eventId   String
  sequence  Int
  senderId  String
  targetId  String
  object    RitualObject
  action    RitualAction
  positionX Float
  positionY Float
  createdAt DateTime     @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, eventId])
  @@unique([roomId, sequence])
  @@index([roomId, createdAt])
}
